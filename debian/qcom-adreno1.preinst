#!/bin/sh
set -e

# Remove existing dpkg-divert
for f in libEGL.so.1 libGLESv1_CM.so.1 libGLESv2.so.2 libOpenCL.so.1
do
    if dpkg-divert --list | grep -q $f; then
        echo "Removing existing diversion for $f"
        dpkg-divert --package adreno1 --remove /usr/lib/aarch64-linux-gnu/$f
    fi
done

